+  [[listener.route]]
+  name = "inherits"
+  use = "fragmented"
+  match_sni = ["a.example"]
+
+  [[listener.route]]
+  name = "disables"
+  use = "fragmented"
+  match_sni = ["b.example"]
+  fragment_client_hello = false
+"#,
+        );
