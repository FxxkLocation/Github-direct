<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GitHub Direct"
            android:textSize="26sp"
            android:textColor="@color/textColorPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            
            <ImageView android:id="@+id/logo" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_app" android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模块状态"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shape_circle_gray" />
                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/textColorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/framework_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Protection Control Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="代理控制"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/vpn_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/textColorPrimary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_vpn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="开启代理"
                android:textColor="@color/colorSurface"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false" />
        </LinearLayout>
        
        <!-- Backend Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_card_title"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_mode_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_auto"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />

                <RadioButton
                    android:id="@+id/rb_mode_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_root"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />

                <RadioButton
                    android:id="@+id/rb_mode_vpn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_vpn"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />

                <RadioButton
                    android:id="@+id/rb_mode_xposed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_xposed"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />
            </RadioGroup>

            <TextView
                android:id="@+id/backend_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backend_status_none"
                android:textSize="13sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/private_dns_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/private_dns_warning"
                android:textSize="12sp"
                android:textColor="@color/colorWarning"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scope_title"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/scope_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_scope_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scope_all"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />

                <RadioButton
                    android:id="@+id/rb_scope_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scope_selected"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />

                <RadioButton
                    android:id="@+id/rb_scope_excluded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scope_excluded"
                    android:textSize="14sp"
                    android:textColor="@color/textColorPrimary" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_pick_apps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_pick_apps"
                android:textColor="@color/colorSurface"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Services Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务统计"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat_services"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/textColorPrimary"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textColorTertiary"
                        android:text="已启服务" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/textColorPrimary"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textColorTertiary"
                        android:text="活动规则" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat_pool"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/textColorPrimary"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/textColorTertiary"
                        android:text="VIP 池" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_services"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="管理服务"
                android:textColor="@color/colorSurface"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Tools Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工具与诊断"
                android:textSize="14sp"
                android:textColor="@color/textColorSecondary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="详细日志输出"
                    android:textSize="13sp"
                    android:textColor="@color/textColorPrimary" />

                <Switch
                    android:id="@+id/diag_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_diag_dns"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_secondary"
                    android:text="测试 DNS"
                    android:textColor="@color/textColorPrimary"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_diag_tcp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_secondary"
                    android:text="测试连通性"
                    android:textColor="@color/textColorPrimary"
                    android:textAllCaps="false" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_diag_full"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_diag_full"
                android:textColor="@color/textColorPrimary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Output Terminal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_console"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="输出日志"
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:textStyle="bold" />

                <ProgressBar android:indeterminateTint="@color/textColorSecondary"
                    android:id="@+id/progress_spinner"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminate="true"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                android:id="@+id/dns_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/textColorPrimary"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Extra Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_tg"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_secondary"
                android:text="加入 Telegram 群组"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_star"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary"
                android:text="给项目一个 Star"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="基于 Xposed 框架本地运行\nCreated by Mai_xiyu"
            android:textSize="12sp"
            android:textColor="@color/textColorTertiary"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
